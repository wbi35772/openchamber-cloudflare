# cf-matrix-channel 运行参数。全部可选：不配置时使用内置默认值，
# 主密钥会在首次运行时自动生成到 <CF_MATRIX_DATA_DIR>/master.key。
# 这个文件只用于显式覆盖，不是启动必需项。切勿提交填好的副本。

# 显式主密钥（优先于 master.key 文件）。留空即使用自动生成的密钥。
# CF_MATRIX_MASTER_KEY=

# 从文件读取主密钥（优先于 <dataDir>/master.key）。
# CF_MATRIX_MASTER_KEY_FILE=

# 状态目录与配置文件位置。
# CF_MATRIX_DATA_DIR=./data
# CF_MATRIX_CONFIG=./data/cf-matrix.config.json

# 端口池与 API 基址。
# CF_PORT_RANGE_START=24001
# CF_PORT_RANGE_END=24250
# CF_API_BASE=https://api.cloudflare.com/client/v4

# 必须保持 true；false 会在启动时报错。
CF_FAIL_CLOSED=true

# Injected by the OpenChamber host for the service entry.
# OPENCHAMBER_SERVICE_PORT=0
# OPENCHAMBER_SERVICE_TOKEN=replace-with-host-token

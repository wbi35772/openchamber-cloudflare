{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openchamber.local/cf-matrix-channel.schema.json",
  "title": "cf-matrix-channel configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "apiBase": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "default": "https://api.cloudflare.com/client/v4"
    },
    "proxyHost": { "type": "string", "minLength": 1, "default": "127.0.0.1" },
    "proxyAuth": { "type": ["string", "null"], "default": null },
    "dataDir": { "type": "string" },
    "portStart": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 24001 },
    "portEnd": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 24250 },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "ttlMs": { "type": "integer", "minimum": 0, "maximum": 3600000 },
        "timeoutMs": { "type": "integer", "minimum": 500, "maximum": 120000 },
        "tcpTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000 }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rps": { "type": "number", "minimum": 0.1, "maximum": 100, "default": 4 },
        "burst": { "type": "number", "minimum": 1, "maximum": 200, "default": 4 },
        "windowLimit": { "type": "integer", "minimum": 1, "maximum": 100000, "default": 950 },
        "windowMs": { "type": "integer", "minimum": 1000, "maximum": 86400000, "default": 300000 },
        "windowBucketMs": { "type": "integer", "minimum": 100 },
        "remainingThreshold": { "type": "integer", "minimum": 0, "default": 50 },
        "jitter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minMs": { "type": "integer", "minimum": 0, "maximum": 600000, "default": 800 },
            "maxMs": { "type": "integer", "minimum": 0, "maximum": 600000, "default": 3200 }
          }
        },
        "backoff": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "baseMs": { "type": "integer", "minimum": 1000, "default": 30000 },
            "maxMs": { "type": "integer", "minimum": 1000, "default": 3600000 },
            "jitterMinMs": { "type": "integer", "minimum": 0, "default": 1000 },
            "jitterMaxMs": { "type": "integer", "minimum": 0, "default": 5000 }
          }
        },
        "quarantineCodes": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "uniqueItems": true
        },
        "cooldownCodes": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "uniqueItems": true
        }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000 },
        "maxRetries": { "type": "integer", "minimum": 0, "maximum": 5 },
        "retryStatuses": { "type": "array", "items": { "type": "integer" }, "uniqueItems": true },
        "retryBaseMs": { "type": "integer", "minimum": 100, "maximum": 60000 }
      }
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 64 },
          "authType": { "enum": ["token", "key"] },
          "token": { "type": "string", "minLength": 20 },
          "email": { "type": "string", "format": "email" },
          "apiKey": { "type": "string", "minLength": 20 },
          "cloudflareAccountId": { "type": "string", "pattern": "^[A-Fa-f0-9]{32}$" },
          "tags": { "type": "array", "items": { "type": "string", "maxLength": 32 }, "uniqueItems": true },
          "proxyPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "egressIpv6": { "type": "string", "pattern": "^[A-Fa-f0-9:]+/[0-9]{1,3}$" },
          "enabled": { "type": "boolean" }
        }
      }
    }
  }
}
